{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "description": "Notes — Aplicação de notas encadeadas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "idb": "8.0.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitest/coverage-v8": "1.6.0",
    "jsdom": "^30.1.3",
    "typescript": "5.4.5",
    "vite": "5.3.1",
    "vitest": "1.6.0"
  }
}
